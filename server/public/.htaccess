Options -Indexes
DirectoryIndex index.php
<Files ".local-root.php">
    Require all denied
</Files>
<Files "boot.php">
    Require all denied
</Files>
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header onsuccess unset Content-Security-Policy "expr=-n resp('X-Rental-Content-Security-Policy')"
    Header always set Content-Security-Policy "expr=%{resp:X-Rental-Content-Security-Policy}" "expr=-n resp('X-Rental-Content-Security-Policy')"
    Header onsuccess unset X-Rental-Content-Security-Policy
    Header always unset X-Rental-Content-Security-Policy
</IfModule>
